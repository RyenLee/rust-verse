{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustVerse",
  "version": "1.3.13",
  "identifier": "com.rustverse.desktop",
  "build": {
    "beforeDevCommand": "node scripts/generate-locale-config.cjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/generate-locale-config.cjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": null,
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/RyenLee/rust-verse/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5RjI0RDE2OTZGN0FGMTUKUldRVnIvZVdGazN5MlFGT0lDekl5ZDEwcC9sbDZZNkNqNE8xVzBWa1Bydk51bWEybk9RRTU3a1EK"
    }
  }
}
