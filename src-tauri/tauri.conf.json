{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustVerse",
  "version": "1.2.4",
  "identifier": "com.rustverse.desktop",
  "build": {
    "beforeDevCommand": "node scripts/generate-locale-config.cjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/bump-version.cjs && node scripts/generate-locale-config.cjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'unsafe-inline' 'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": null,
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://releases.example.com/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NENBM0IxNzM2Q0ZDMDYKUldRRy9HeHpzYU5NeU9LWDAyMlpsbk5vZFdpNVUxOXZXelVTSDN3eDF1akRjVHlWS3dpNng1Sk0K"
    }
  }
}
